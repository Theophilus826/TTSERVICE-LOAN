<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ====================================== -->
    <!-- INTERNET ACCESS                        -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.INTERNET" />


    <!-- ====================================== -->
    <!-- FLOATING LOAN REMINDERS                -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />


    <!-- ====================================== -->
    <!-- NOTIFICATIONS                          -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <!-- ====================================== -->
    <!-- BOOT RESTORATION                       -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <!-- ====================================== -->
    <!-- REMINDER ALARM SCHEDULING              -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />


    <!-- ====================================== -->
    <!-- ANDROID CALENDAR INTEGRATION           -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.WRITE_CALENDAR" />


    <!-- ====================================== -->
    <!-- BIOMETRIC AUTHENTICATION               -->
    <!-- ====================================== -->

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">


        <!-- ====================================== -->
        <!-- FLOATING LOAN REMINDER SERVICE         -->
        <!-- ====================================== -->

        <service
            android:name=".FloatingReminderService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled floating loan payment reminders for unpaid loan installments" />

        </service>


        <!-- ====================================== -->
        <!-- FLOATING REMINDER AND SNOOZE RECEIVER  -->
        <!-- ====================================== -->

        <receiver
            android:name=".FloatingReminderReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="com.menumoney.RECHECK_FLOATING_REMINDER" />
                <action android:name="com.menumoney.RESTORE_AFTER_BOOT" />
            </intent-filter>

        </receiver>


        <!-- ====================================== -->
        <!-- DEVICE BOOT AND APP UPDATE RECEIVER   -->
        <!-- ====================================== -->

        <receiver
            android:name=".BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

        </receiver>


        <receiver
        android:name=".LoanDeviceAdminReceiver"
        android:label="@string/device_admin_label"
        android:description="@string/device_admin_description"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:exported="true">

        <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/device_admin" />

        <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
    </intent-filter>

    </receiver>


        <!-- ====================================== -->
        <!-- MAIN CAPACITOR ACTIVITY                -->
        <!-- ====================================== -->

        <activity
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <!-- ====================================== -->
        <!-- FILE SHARING PROVIDER                  -->
        <!-- ====================================== -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>


        <!-- ====================================== -->
        <!-- LOAN HOME-SCREEN WIDGET                -->
        <!-- ====================================== -->

        <receiver
            android:name=".LoanWidget"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/loan_widget_info" />

        </receiver>


    </application>

</manifest>
