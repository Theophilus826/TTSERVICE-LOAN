<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loan_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/loan_widget_background">

    <TextView
        android:id="@+id/loan_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ PAYMENT DUE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/loan_widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your loan payment is due."
        android:textSize="14sp"
        android:textColor="#FFFFFF"/>

</LinearLayout>